# ---------------------------------------------------------------------------
# Magsar Physics — орчны хувьсагчид
# Энэ файлыг .env.local нэрээр хуулж, утгуудаа бөглөнө үү.
# .env.local файлыг git-д ХЭЗЭЭ Ч оруулахгүй (.gitignore-д бүртгэсэн).
# ---------------------------------------------------------------------------

# Сайтын бүтэн хаяг (sitemap, Open Graph, canonical холбоосод ашиглана).
# Vercel дээр тохируулаагүй бол production домэйныг автоматаар авна.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
# Эдгээр хоёрыг хөтөчид ил гаргахад аюулгүй (RLS нь зөвхөн нийтлэгдсэн агуулгыг уншуулна).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# НУУЦ: service role (эсвэл шинэ "secret") түлхүүр. Зөвхөн серверт хэрэглэнэ.
# NEXT_PUBLIC_ угтвар хэзээ ч бүү залга.
SUPABASE_SERVICE_ROLE_KEY=

# Агуулгын удирдлагад (/admin) нэвтрэх нууц үг — урт, санамсаргүй нууц үг сонгоно уу.
ADMIN_PASSWORD=

# Админ сессийн cookie-г гарын үсгээр баталгаажуулах түлхүүр (32-оос дээш тэмдэгт).
# Үүсгэх: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Заавал биш: албан ёсны YouTube сувгийн холбоос. Тохируулсан үед хөл хэсэгт харагдана.
# Жишээ: https://www.youtube.com/@your-channel
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=
